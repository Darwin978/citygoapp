{
  "expo": {
    "name": "cityGoApp",
    "slug": "cityGoApp",
    "scheme": "citygo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "cover",
      "backgroundColor": "#000000",
      "image": "./assets/negro.jpg"
    },
    "ios": {
      "googleServicesFile": "./firebase/GoogleService-Info.plist",
      "bundleIdentifier": "com.citygo",
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyBfVCCME9FaQG7zUd0xbeAQDehrYnFrpZA"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Utilizamos tu ubicación para mostrar tu posición en el mapa y ayudarte a localizar y monitorear las carreras",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Utilizamos tu ubicación para permitir el monitoreo continuo de carreras."
      }
    },
    "android": {
      "googleServicesFile": "./firebase/google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "POST_NOTIFICATIONS",
        "USE_FULL_SCREEN_INTENT",
        "VIBRATE",
        "WAKE_LOCK",
        "SYSTEM_ALERT_WINDOW"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.citygo",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBfVCCME9FaQG7zUd0xbeAQDehrYnFrpZA"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "aa054fc9-3b9d-4bae-b934-c1b960d00147"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/notificacion.mp3"
          ]
        }
      ],
      "./plugins/withModularHeadersIOS",
      "./plugins/withNotificationIcon",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ]
  }
}
