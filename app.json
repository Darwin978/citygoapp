{
  "expo": {
    "name": "CityGo",
    "slug": "cityGoApp",
    "scheme": "citygo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "notification": {
      "icon": "./assets/notification_icon.png",
      "color": "#1D4ED8"
    },
    "splash": {
      "resizeMode": "cover",
      "backgroundColor": "#000000",
      "image": "./assets/negro.png"
    },
    "ios": {
      "googleServicesFile": "./firebase/GoogleService-Info.plist",
      "bundleIdentifier": "com.citygo",
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyBfVCCME9FaQG7zUd0xbeAQDehrYnFrpZA"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Utilizamos tu ubicación para mostrar tu posición en el mapa y ayudarte a localizar y monitorear las carreras",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Utilizamos tu ubicación para permitir el monitoreo continuo de carreras incluso con la app en segundo plano.",
        "NSLocationAlwaysUsageDescription": "Necesitamos tu ubicación en todo momento para enviarte carreras mientras usas otras apps.",
        "UIBackgroundModes": [
          "location",
          "remote-notification",
          "fetch"
        ]
      }
    },
    "android": {
      "googleServicesFile": "./firebase/google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "USE_FULL_SCREEN_INTENT",
        "VIBRATE",
        "WAKE_LOCK",
        "SYSTEM_ALERT_WINDOW",
        "RECEIVE_BOOT_COMPLETED",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.citygo",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBfVCCME9FaQG7zUd0xbeAQDehrYnFrpZA"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "aa054fc9-3b9d-4bae-b934-c1b960d00147"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/notificacion.mp3"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a CityGo acceder a tu ubicación siempre para recibir carreras en segundo plano.",
          "locationAlwaysPermission": "Permite a CityGo acceder a tu ubicación siempre.",
          "locationWhenInUsePermission": "Permite a CityGo acceder a tu ubicación mientras la app está en uso.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "./plugins/withModularHeadersIOS",
      "./plugins/withNotificationIcon",
      "./plugins/withKeepAliveAndroid",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-font"
    ]
  }
}
